{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tools file",
  "type": "object",
  "required": ["tools"],
  "additionalProperties": false,
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "category", "tier", "url", "source", "last_checked"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "category": { "enum": ["ai", "boilerplate", "payments", "cloud-credits", "analytics", "devops", "gtm", "comms", "other"] },
          "tier": { "enum": ["top", "solid", "emerging"] },
          "url": { "type": "string", "format": "uri" },
          "pricing": { "type": "string" },
          "note": { "type": "string" },
          "source": { "type": "string" },
          "last_checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grants file",
  "type": "object",
  "required": ["grants"],
  "additionalProperties": false,
  "properties": {
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "scope", "amount", "equity", "url", "source", "last_checked"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "scope": { "enum": ["pan-africa", "multi-country", "country", "global"] },
          "country": { "type": "string" },
          "amount": { "type": "string" },
          "equity": { "type": "string" },
          "window": { "type": "string" },
          "eligibility": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "source": { "type": "string", "format": "uri" },
          "last_checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
        }
      }
    }
  }
}
